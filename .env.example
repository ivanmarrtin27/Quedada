# AdMob / env locales (NO subir secretos reales a git)
# Copia a .env.local y rellena tras crear la app en https://admob.google.com

EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXX~YYYY
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXX/ZZZZ

# Opcional iOS
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXX~YYYY
